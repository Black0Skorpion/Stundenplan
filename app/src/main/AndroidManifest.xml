<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Wecker vor der ersten Veranstaltung (klingelt auch im gesperrten Zustand) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Täglicher Abgleich mit PULS nur ohne mobile Daten -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Live Update (Android 16): hervorgehobene Mitteilung der laufenden Veranstaltung -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.Reiter"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PulsActivity"
            android:exported="false"
            android:label="Modulwahl (PULS)"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".EinfuehrungActivity"
            android:exported="false"
            android:theme="@style/AppTheme.Reiter" />

        <activity
            android:name=".VerzeichnisActivity"
            android:exported="false"
            android:label="Vorlesungsverzeichnis" />

        <activity
            android:name=".VorschauActivity"
            android:exported="false"
            android:label="Widget-Vorschau" />

        <activity
            android:name=".TeilenActivity"
            android:exported="false"
            android:label="Plan teilen" />

        <activity
            android:name=".WeckerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:label="Wecker" />

        <!-- Geteilte Pläne: Link/QR-Code stundenplan://teilen?d=… oder .ics-Datei -->
        <activity
            android:name=".EmpfangActivity"
            android:exported="true"
            android:label="Stundenplan">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stundenplan" android:host="teilen" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/calendar" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LageplanActivity"
            android:exported="false"
            android:label="Lageplan Golm" />

        <receiver
            android:name=".WidgetKlein"
            android:exported="true"
            android:label="@string/widget_klein">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_klein" />
        </receiver>

        <receiver
            android:name=".WidgetMittel"
            android:exported="true"
            android:label="@string/widget_mittel">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mittel" />
        </receiver>

        <receiver
            android:name=".WidgetGross"
            android:exported="true"
            android:label="@string/widget_gross">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_gross" />
        </receiver>

        <receiver
            android:name=".MensaKlein"
            android:exported="true"
            android:label="@string/mensa_klein">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mensa_klein" />
        </receiver>

        <receiver
            android:name=".MensaMittel"
            android:exported="true"
            android:label="@string/mensa_mittel">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mensa_mittel" />
        </receiver>

        <receiver
            android:name=".MensaGross"
            android:exported="true"
            android:label="@string/mensa_gross">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mensa_gross" />
        </receiver>

        <receiver
            android:name=".AbfahrtenWidget"
            android:exported="true"
            android:label="@string/abfahrten_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/abfahrten" />
        </receiver>

        <receiver
            android:name=".Erinnerungen"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".LiveUpdate"
            android:exported="false" />

        <service
            android:name=".PulsJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <provider
            android:name=".Dateien"
            android:authorities="de.stundenplan.widget.dateien"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".Aktualisierer"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
