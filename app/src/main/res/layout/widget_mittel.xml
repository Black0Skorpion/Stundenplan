<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_hintergrund"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/bild"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="fitStart" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Links: Kopf → Planer, Karte → Lageplan -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="47"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/zone_kopf"
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <FrameLayout
                android:id="@+id/zone_karte"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <!-- Rechts: Tagesliste, jede Zeile → Lageplan -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="53"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="19dp" />

            <FrameLayout
                android:id="@+id/zone_z1"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginBottom="3dp" />

            <FrameLayout
                android:id="@+id/zone_z2"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginBottom="3dp" />

            <FrameLayout
                android:id="@+id/zone_z3"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginBottom="3dp" />

            <FrameLayout
                android:id="@+id/zone_z4"
                android:layout_width="match_parent"
                android:layout_height="30dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
